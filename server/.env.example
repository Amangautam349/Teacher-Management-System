# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/tms_db?sslmode=require

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Used only by npm run seed to create the first Super Admin
SEED_ADMIN_EMAIL=admin@tms.local
SEED_ADMIN_PASSWORD=replace_with_a_strong_unique_password
SEED_ADMIN_NAME=System Admin
